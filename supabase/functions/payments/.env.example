# Secrets for the "payments" Edge Function. Placeholders only: never put real values in this file or in GitHub.
# Set them with:  supabase secrets set --env-file ./supabase/functions/payments/.env   (that .env file is git-ignored)

# Which provider takes new checkouts: bcel | mock
PAYMENT_PROVIDER=
# production | staging   (the test provider is refused in production)
PAYMENT_ENV=
# Where learners return after paying, e.g. https://kdgh-sketch.github.io/LaoLao-Hub/
PAYMENT_APP_URL=
# Browser origins allowed to call the function (comma separated), e.g. https://kdgh-sketch.github.io
PAYMENT_ALLOWED_ORIGINS=

# BCEL Online Payment Gateway (CyberSource Secure Acceptance profile, from BCEL)
BCEL_SA_ENDPOINT=
BCEL_SA_PROFILE_ID=
BCEL_SA_ACCESS_KEY=
BCEL_SA_SECRET_KEY=
BCEL_SA_LOCALE=en
BCEL_SA_PRESELECT_CARD=false

# Test provider (staging only)
PAYMENT_ALLOW_MOCK=
PAYMENT_MOCK_SECRET=
