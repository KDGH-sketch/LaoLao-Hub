          "zh": "{P} ບໍ່ ດື່ມ {DRINK} .",
          "en": "{P} {P.do} not drink {DRINK.e} ."
        },
        {
          "zh": "{P} ບໍ່ ຊື້ {O} .",
          "en": "{P} {P.do} not buy {O.e} ."
        },
