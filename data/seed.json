            {
              "z": "ຂ້ອຍ",
              "p": "khɔ̀ɔi"
            },
            {
              "z": "ບໍ່",
              "p": "bɔ̀ɔ"
            },
            {
              "z": "ກິນ",
              "p": "kin"
            },
            {
              "z": "ຊີ້ນ",
              "p": "sîin"
            }
          ],
          "tr": {
            "en": "I don't eat meat."
          }
        },
        {
          "zh": "ມື້ນີ້ລາວບໍ່ສະບາຍ.",
          "py": "Mɯ̂ɯ nîi láao bɔ̀ɔ sà-bāai.",
          "tokens": [
            {
              "z": "ມື້ນີ້",
              "p": "mɯ̂ɯ nîi"
            },
            {
              "z": "ລາວ",
              "p": "láao"
            },
            {
              "z": "ບໍ່",
              "p": "bɔ̀ɔ"
            },
            {
              "z": "ສະບາຍ",
              "p": "sà-bāai"
            }
          ],
          "tr": {
            "en": "Today he is not well."
          }
        }
      ],
      "gen": [
