    {
      "id": "p002",
      "n": 2,
      "sec": "A",
      "hz": "ບໍ່…",
      "py": "bɔ̀ɔ…",
      "gloss": "negation (do not / not)",
      "level": 1,
      "formula": "S + ບໍ່ + V / Adj",
      "tr": {
        "en": {
          "meaning": "standard negative construction: 'do not / is not'",
          "how": "Place ບໍ່ directly before the verb or adjective you want to negate. In Lao, verbs do not change form.",
          "note": "For 'is not a [noun]', use ບໍ່ແມ່ນ."
        },
        "lo": {
          "meaning": "ປະຕິເສດການກະທຳ ຫຼື ຄຸນລັກສະນະ (ບໍ່ + ກິລິຍາ/ຄຸນນາມ)"
        },
        "zh": {
          "meaning": "否定句 (不 + 动词/形容词)"
        }
      },
      "mistake": {
        "wrong": "ຂ້ອຍກິນບໍ່ເຂົ້າ",
        "right": "ຂ້ອຍບໍ່ກິນເຂົ້າ",
        "tr": {
          "en": "ບໍ່ goes before the verb (ກິນ), not after it."
        }
      },
      "examples": [
        {
          "zh": "ຂ້ອຍບໍ່ກິນຊີ້ນ.",
          "py": "Khɔ̀ɔi bɔ̀ɔ kin sîin.",
