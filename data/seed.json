    {
      "id": "p003",
      "n": 3,
      "sec": "A",
      "hz": "…ບໍ? (ຫຼື ບໍ່?)",
      "py": "…bɔ̀ɔ?",
      "gloss": "yes/no question",
      "level": 1,
      "formula": "Statement + ບໍ ?",
      "tr": {
        "en": {
          "meaning": "forms a yes/no question at the end of a sentence",
          "how": "Add ບໍ (or ບໍ່) to the end of any statement to turn it into a question, exactly like '吗' in Chinese or 'right?' in English.",
          "note": "Respond with the verb to agree, or ບໍ່ + verb to disagree."
        },
        "lo": {
          "meaning": "ສ້າງປະໂຫຍກຄຳຖາມ ແມ່ນ/ບໍ່ແມ່ນ ໂດຍໃສ່ ບໍ? ທ້າຍປະໂຫຍກ"
        },
        "zh": {
          "meaning": "是非疑问句 (相当于 '吗？')"
        }
      },
      "mistake": {
