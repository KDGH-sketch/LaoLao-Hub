{
  "patterns": [
    {
      "id": "p001",
      "n": 1,
      "sec": "A",
      "hz": "ແມ່ນ…ແລ້ວ",
      "py": "mâaen…lɛ̂ɛo",
      "gloss": "is/are already",
      "level": 1,
      "formula": "S + ແມ່ນ + N / Adj + ແລ້ວ",
      "tr": {
        "en": {
          "meaning": "confirms that something is indeed the case or already happened",
          "how": "Use ແມ່ນ to affirm identity or truth, and ແລ້ວ at the end to show completion or agreement: 'Yes, that is already true / It is indeed so.'",
          "note": "To negate, use ບໍ່ແມ່ນ."
        },
        "lo": {
          "meaning": "ຢືນຢັນວ່າຖືກຕ້ອງ ຫຼື ເປັນແນວນັ້ນແລ້ວ"
        },
        "zh": {
          "meaning": "确实是这样 / 已经…了"
        }
      },
      "mistake": {
        "wrong": "ຂ້ອຍແມ່ນນັກຮຽນບໍແມ່ນແລ້ວ",
        "right": "ຂ້ອຍແມ່ນນັກຮຽນແລ້ວ",
        "tr": {
          "en": "Don't combine question ບໍ with affirmation ແລ້ວ in the same clause."
        }
      },
      "examples": [
        {
          "zh": "ແມ່ນແລ້ວ, ຂ້ອຍແມ່ນຄົນລາວ.",
          "py": "Mâaen lɛ̂ɛo, khɔ̀ɔi mâaen khon láao.",
          "tokens": [
            {
              "z": "ແມ່ນ",
              "p": "mâaen"
            },
            {
              "z": "ແລ້ວ",
              "p": "lɛ̂ɛo"
            },
            {
              "z": "ຂ້ອຍ",
              "p": "khɔ̀ɔi"
            },
            {
              "z": "ແມ່ນ",
              "p": "mâaen"
            },
            {
              "z": "ຄົນລາວ",
              "p": "khon láao"
            }
          ],
          "tr": {
            "en": "That's right, I am Lao."
          }
        },
        {
          "zh": "ອັນນີ້ແມ່ນຂອງຂ້ອຍແລ້ວ.",
          "py": "An nîi mâaen khɔ̌ɔng khɔ̀ɔi lɛ̂ɛo.",
          "tokens": [
            {
              "z": "ອັນນີ້",
              "p": "an nîi"
            },
            {
              "z": "ແມ່ນ",
              "p": "mâaen"
            },
            {
              "z": "ຂອງຂ້ອຍ",
              "p": "khɔ̌ɔng khɔ̀ɔi"
            },
            {
              "z": "ແລ້ວ",
              "p": "lɛ̂ɛo"
            }
          ],
          "tr": {
            "en": "This is already mine."
          }
        }
      ],
      "gen": [
        {
          "zh": "{P} ແມ່ນ {OCC} ແລ້ວ .",
          "en": "{P} [[be]] already {OCC.e} ."
        },
        {
          "zh": "ອັນນີ້ ແມ່ນ {O} ຂອງ {P} .",
          "en": "This is {P.ps} {O.e} ."
